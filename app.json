{
  "expo": {
    "name": "Jump & Spin Lab",
    "slug": "jump-spin-lab",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSMotionUsageDescription": "Jump & Spin Lab uses the motion sensors to measure your jumps, spins, reaction and balance."
      },
      "bundleIdentifier": "com.thapananthongpak.jumpspinlab",
      "appleTeamId": "4UQ96JPUX2"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.HIGH_SAMPLING_RATE_SENSORS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-sqlite",
      [
        "expo-sensors",
        {
          "motionPermission": "Jump & Spin Lab uses the motion sensors to measure your jumps, spins, reaction and balance."
        }
      ],
      "expo-font"
    ],
    "scheme": "jumpspinlab",
    "experiments": {
      "typedRoutes": false
    }
  }
}
